# Local / example environment — DO NOT use these secrets in production.
# See docs/ops/PRODUCTION.md for production values.

DJANGO_SETTINGS_ENV=local
DJANGO_SECRET_KEY=dev-change-me-in-production-use-32chars-min
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

MYSQL_DATABASE=signdesk
MYSQL_USER=signdesk
MYSQL_PASSWORD=signdesk
MYSQL_HOST=mysql
# Container-internal MySQL port (Docker DNS). Host publish uses MYSQL_HOST_PORT.
MYSQL_PORT=3306
# ProgressPhase: localhost:3306  |  SignDesk: localhost:3307
MYSQL_HOST_PORT=3307
# Managed MySQL SSL (production / DigitalOcean):
# MYSQL_SSL_CA=/certs/mysql-ca.crt
# MYSQL_SSL_REQUIRED=true

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

EMAIL_HOST=mailpit
# Container-internal SMTP port (Docker DNS). Host publish uses MAILPIT_SMTP_PORT below.
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SignDesk <noreply@signdeskcrm.com>

# Production Postmark (HTTP API on :443 — preferred on DigitalOcean):
# SMTP_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=
# DEFAULT_FROM_EMAIL=SignDesk <noreply@signdeskcrm.com>

# Host-published Mailpit ports (defaults avoid ProgressPhase's 8025).
# ProgressPhase: http://localhost:8025  |  SignDesk: http://localhost:8026
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# Host publish for API / Redis (container-internal ports stay 8000 / 6379).
# ProgressPhase API: localhost:8000  |  SignDesk: localhost:8001
API_HOST_PORT=8001
REDIS_HOST_PORT=6379

BASE_DOMAIN=signdeskcrm.test
FRONTEND_PORT=5173
FRONTEND_PROTOCOL=http
API_PROTOCOL=http
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25

# Free trial (Phase 1)
# TRIAL_DAYS=15
# TRIAL_WARNING_HOURS=24

# DigitalOcean Spaces (optional locally; set in production for e-sign media).
# Leave DO_SPACES_BUCKET blank to use local MEDIA_ROOT.
# DO_SPACES_BUCKET=signdesk-media
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_REGION=nyc3
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_CDN_DOMAIN=

# Traefik / Let's Encrypt (DNS-01 on DigitalOcean):
# ACME_EMAIL=ops@yourdomain.com
# DO_AUTH_TOKEN=<do-api-token-with-domain-write>
# BASE_DOMAIN_REGEX=signdeskcrm\.com

# Production-only (leave blank locally):
# CSRF_TRUSTED_ORIGINS=https://signdeskcrm.com,https://www.signdeskcrm.com
# SECURE_SSL_REDIRECT=true
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# MYSQL_ROOT_PASSWORD=
