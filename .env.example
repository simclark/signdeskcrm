DJANGO_SETTINGS_ENV=local
DJANGO_SECRET_KEY=dev-change-me-in-production-use-32chars-min
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

MYSQL_DATABASE=signdesk
MYSQL_USER=signdesk
MYSQL_PASSWORD=signdesk
MYSQL_HOST=mysql
MYSQL_PORT=3306

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=SignDesk <noreply@signdeskcrm.com>

BASE_DOMAIN=localhost
FRONTEND_PORT=5173
FRONTEND_PROTOCOL=http
API_PROTOCOL=http
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
